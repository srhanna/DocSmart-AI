# Vercel Blob store token
# Obtain from: Vercel dashboard → Storage → doc-smart-ai-blob → Environment Variables tab.
# Never commit .env.local to source control.
BLOB_READ_WRITE_TOKEN=

# Vercel AI Gateway token (for AI document processing)
# Obtain from: Vercel dashboard → AI Gateway → Tokens tab → Create Token.
# See: https://vercel.com/{your-team}/~/ai-gateway/tokens
AI_GATEWAY_API_KEY=
