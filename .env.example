# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file containing real credentials to git.
#
# Vercel tokens and other secrets must be added via the Vercel dashboard
# (Project Settings > Environment Variables) and never hardcoded here.

# Example: if your app requires an external AI API key, set it here
# OPENAI_API_KEY=your_openai_api_key_here

# Google Ads conversion ID (e.g. AW-1234567890).
# When set, the Google Ads global site tag (gtag.js) is loaded on every page.
# Leave blank or omit to disable ads tracking.
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
