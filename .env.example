# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file containing real credentials to git.
#
# Vercel tokens and other secrets must be added via the Vercel dashboard
# (Project Settings > Environment Variables) and never hardcoded here.

# Example: if your app requires an external AI API key, set it here
# OPENAI_API_KEY=your_openai_api_key_here

# Google AdSense publisher client ID (e.g. ca-pub-1234567890123456).
# When set:
#   - The AdSense auto-ads script is loaded on every page (Google automatically
#     places ads across the site — no additional code required).
#   - The /ads.txt file is served dynamically with your publisher info so
#     Google can verify you are an authorized seller.
# Find your client ID in AdSense → Account → Account information → Publisher ID.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Google AdSense ad-slot ID for the manual in-page ad unit rendered below the
# document processor.  Find it in AdSense → Ads → By ad unit → Ad unit code.
# When omitted the manual ad unit is hidden; auto-ads still run if the client
# ID above is set.
# NEXT_PUBLIC_ADSENSE_SLOT_ID=XXXXXXXXXX

# Google Ads conversion ID (e.g. AW-1234567890).
# When set, the Google Ads global site tag (gtag.js) is loaded on every page.
# Leave blank or omit to disable ads tracking.
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX

# Google Ads conversion label for the "document processed" conversion action.
# Format: AW-XXXXXXXXXX/XXXXXXXXXXXXXXXXXXXX  (full send_to value from your
# conversion action in Google Ads → Goals → Conversions).
# When omitted a generic 'document_processed' analytics event is sent instead.
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=AW-XXXXXXXXXX/XXXXXXXXXXXXXXXXXXXX
